<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面自适应图标的前景层：图案本身已按安全区缩放（见 logo_art.xml）。

     item 不写死 dp 尺寸而用 gravity="fill"：平台把前景层按 1.5× 图标边界绘制，
     写死尺寸会让图案不随图标大小缩放，密度越高的设备裁得越狠。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/logo_art"
        android:gravity="fill" />
</layer-list>
