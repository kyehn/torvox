<?xml version="1.0" encoding="utf-8"?>
<!-- 启动屏图案的收缩包装（splash_icon 的唯一帧）。
     平台直接把本层画到 192dp 图标单元，item 的绝对尺寸就是屏幕尺寸：
     263dp = 旧位图路径的 148dp × (192/108)，图案与修复前同大。
     logo_art 已按自适应图标安全区预缩放 0.75（见 logo_art.xml），
     263dp 下墨迹最远半径 ≈ 48.51×0.75/108×263 ≈ 88.6dp，略小于蒙版安全半径
     88.9dp：星尖与终端窗口四角几乎顶到蒙版边缘，不再缩成一小团；
     终端窗口最远角最多被蒙版裁掉一个角（见 logo_art.xml 的 0.75 说明）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="263dp"
        android:height="263dp"
        android:gravity="center"
        android:drawable="@drawable/logo_art" />
</layer-list>
