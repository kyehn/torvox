<?xml version="1.0" encoding="utf-8"?>
<!-- 启动屏图标（windowSplashScreenAnimatedIcon）：logo_art 的收缩包装。
     平台 SplashscreenContentDrawer 把这里的 drawable 画进 160dp×1.2=192dp 的
     图标单元，并按默认圆形蒙版（config_icon_mask：单元的 50/108 ≈ 88.9dp）
     裁掉蒙版外的内容；直接引用 logo_art（108dp 视口）时被放大 192/108=1.78 倍，
     墨迹最远半径 ≈ 89.4dp 恰超蒙版，星角与终端窗口的一角被裁掉
     （STATUS「启动动画图案不完整，被限制到图标形状」）。
     给一份 96dp 的固定尺寸 item 后，图案整体 0.89 倍居中，
     墨迹最远半径 ≈ 44.7dp ≤ 88.9dp，完整落进蒙版圆且一角不被裁。
     桌面图标仍由 launcher_foreground.xml 以 1:1 呈现图案，两处互不影响。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/logo_art" />
</layer-list>
