<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 表面/表面前景主题属性（属性名与 M3 对齐）：本应用不带
         material Views 库，属性在应用侧声明，值取 M3 dark baseline 色板；
         选择菜单等按主题取色，禁止字面颜色值。 -->
    <attr name="colorSurface" format="color" />
    <attr name="colorOnSurface" format="color" />
    <style name="Theme.Terminal" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- 启动期窗口底色：onCreate 随即换成 TRANSPARENT（边到边），此处只为
             冷启动首帧不白闪。不跟日/夜：主题设置在 DataStore 里异步才可读，
             资源限定符拿不到它。系统栏底色不声明：API 29+ 边到边下不生效，
             真正可见的是图标明暗，由 MainActivity 按终端主题亮度运行时设置。 -->
        <item name="android:windowBackground">#1E1E2E</item>
        <!-- Pin the ActionMode toolbar (selection context menu)
             to the terminal panel color instead of the system dynamic
             accent. User requirement: the menu must look like a system
             toolbar with neutral colors, not an accent-colored banner. -->
        <item name="android:actionModeBackground">@color/action_mode_background</item>
        <item name="android:actionModeCloseDrawable">@android:drawable/ic_menu_close_clear_cancel</item>
        <item name="colorSurface">@color/material_color_surface</item>
        <item name="colorOnSurface">@color/material_color_on_surface</item>
    </style>
    <!-- 系统启动屏：冷启动首帧前显示主题背景而非黑闪，
         MainActivity.onCreate 内 installSplashScreen 切回本主题。
         图标只给前景图形，不给 @mipmap/ic_launcher：平台对
         windowSplashScreenAnimatedIcon 不做自适应图标的「只取前景」处理，收到
         自适应图标就照原样连底板整块画出来（完整图案）且四周被 192dp 圆裁掉；
         收到非自适应图形时才把它放大 1.5 倍画在 windowSplashScreenBackground 上，
         与 Android 13 默认的「图标 + 底色」启动屏一致。父主题用 Theme.SplashScreen
         （不声明 windowSplashScreenIconBackgroundColor，图标后不加圆形底板）。 -->
    <style name="Theme.Terminal.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1E1E2E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Terminal</item>
    </style>
</resources>
