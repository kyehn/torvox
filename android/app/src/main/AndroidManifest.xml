<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 文件权限（DESIGN 软件节「声明文件权限（不提示，允许用户自行授权），支持 /sdcard 目录」）。
         WRITE_EXTERNAL_STORAGE 在 targetSdk 28 下随安装授予（沿用 legacy 存储视图），
         终端子进程与宿主同 UID，因而直接可读写 /sdcard；
         MANAGE_EXTERNAL_STORAGE 是「所有文件访问」开关，由用户自行在系统设置里开启，
         应用不弹窗提示。两者都与上游 Termux 的清单一致。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".TerminalApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Terminal">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|fontScale"
            android:theme="@style/Theme.Terminal.Splash"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".service.TerminalForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- Test-only install helper: runs in its OWN process
             (:install) so the app's SELinux domain applies even when the
             main process is an instrumentation target (whose domain is the
             TEST package's — it cannot write filesDir). -->
        <service
            android:name=".installer.BootstrapInstallService"
            android:exported="false"
            android:process=":install" />

        <!-- AOSP DocumentsProvider.attachInfo 强制要求 readPermission 与 writePermission
             同时为 MANAGE_DOCUMENTS，缺一即 attach 时抛 SecurityException
             （"Provider must be protected by MANAGE_DOCUMENTS"）——这是提供器能被
             系统识别的前提，不是可选加固。
             注意不是 android:permission：那个字段填 ProviderInfo.permission，
             内容提供器访问路径根本不读它，写了等于没写，提供者对全设备应用裸奔。
             SAF 客户端不受影响：enforceRead/WritePermissionInner 先查
             checkUriPermission(本 uri)，持有逐 URI 授权即直接放行，
             MANAGE_DOCUMENTS 只是报错信息的后缀。 -->
        <provider
            android:name=".TerminalDocumentsProvider"
            android:authorities="com.termux.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:readPermission="android.permission.MANAGE_DOCUMENTS"
            android:writePermission="android.permission.MANAGE_DOCUMENTS"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

    </application>

</manifest>
