+pub fn mode_get(
+    terminal_: Terminal,
+    mode: c_int,
+    out_value: *bool,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const mode_enum = modes.modeFromInt(@intCast(mode), true) orelse return .invalid_value;
+    out_value.* = wrapper.terminal.modes.get(mode_enum);
+    return .success;
+}
+
+pub fn mode_set(
+    terminal_: Terminal,
+    mode: c_int,
+    value: bool,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const mode_enum = modes.modeFromInt(@intCast(mode), true) orelse return .invalid_value;
+    wrapper.terminal.modes.set(mode_enum, value);
+    return .success;
+}
