{
  "minLines": 8,
  "minTokens": 40,
  "ignore": [
    "**/target/**",
    "**/build/**",
    "**/.gradle/**",
    "**/.idea/**",
    "**/node_modules/**",
    "**/.cargo/**"
  ],
  "ignorePattern": [
    "^import$",
    "^\\s*//\\s*(SAFETY|jscpd:ignore|Generated|Copyright|SPDX).*$"
  ],
  "reporters": ["console-full"]
}